[Unit]
Description=CJD Control Panel
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/cjd-control-panel
ExecStart=%h/cjd-control-panel/.venv/bin/python -m cjd_panel --config %h/cjd-control-panel/.panel.json
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
